<%- include('../partials/head') %>
  <body>
    <%- include('../partials/nav') %>
    <div class="flex justify-center items-center min-h-screen bg-gray-100">
  <div class="bg-white p-8 rounded-lg shadow-lg w-96">

    <h1 class="text-3xl font-bold text-center text-red-500 mb-6">
      <%= editing ? "Edit your Home":"Enter your home details here" %>
    </h1>
    <form action="/host<%= editing ? "/edit-home" : "/add-home" %>"/add-home" method="POST" class="flex flex-col gap-4">

  <!-- Home Name -->
   <input type="hidden" name="id" value="<%= editing ? home.id : "" %>">
  <input
    type="text"
    name="home"
    value="<%= editing ? home.home : "" %>"
    placeholder="Home Name"
    class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- Location -->
  <input
    type="text"
    name="location"
    value="<%= editing ? home.location : "" %>"
    placeholder="Location"
    class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- Price Per Night -->
  <input
    type="number"
    name="price"
    value="<%= editing ? home.price : "" %>"
    placeholder="Price per Night (₹)"
    min="0"
    class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- Rating -->
  <input
    type="number"
    name="rating"
    value="<%= editing ? home.rating : "" %>"
    placeholder="Rating (1-5)"
    min="1"
    max="5"
    step="0.1"
    class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- Photo URL -->
  <input
    type="text"
    name="photo"
    value="<%= editing ? home.photo : "" %>"
    placeholder="Photo URL"
    class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
  />

  <!-- Description -->
<textarea
  name="description"
  placeholder="Describe your home..."
  rows="4"
  class="border border-gray-300 rounded-lg p-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-400"
><%= editing ? home.description : "" %></textarea>

  <!-- Submit Button -->
  <input
    type="submit"
    value="<%= editing ? "update home" : "add Home" %>"
    class="bg-red-500 text-white p-3 rounded-lg cursor-pointer hover:bg-red-600 transition duration-300"
  />

</form>
  </div>
</div>
  </body>
</html>
