<%- include('../partials/head') %>

<body class="bg-gray-100">

  <%- include('../partials/nav') %>

  <!-- Heading -->
  <section class="py-14 bg-white shadow-sm">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h1 class="text-5xl font-extrabold text-gray-800">
        🏡 Explore Registered Homes
      </h1>

      <p class="mt-4 text-lg text-gray-500">
        Manage all your listed properties in one place.
      </p>
    </div>
  </section>

  <!-- Cards -->
  <div class="max-w-7xl mx-auto px-6 py-12">

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

      <% regHouses.forEach(house => { %>

      <div
        class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">

        <!-- Image -->
        <div class="overflow-hidden">
          <img
            src="/<%= house.photo %>"
            alt="<%= house.home %>"
            class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500">
        </div>

        <!-- Content -->
        <div class="p-6">

          <!-- Title & Rating -->
          <div class="flex justify-between items-start">

            <div>
              <h2 class="text-2xl font-bold text-gray-800">
                <%= house.home %>
              </h2>

              <p class="text-gray-500 mt-2">
                📍 <%= house.location %>
              </p>
            </div>

            <span
              class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-semibold">
              ⭐ <%= house.rating %>
            </span>

          </div>

          <!-- Description -->
          <p class="mt-5 text-gray-600 leading-relaxed line-clamp-3">
            <%= house.description %>
          </p>

          <!-- Price -->
          <div class="border-t border-gray-200 mt-6 pt-5 flex justify-between items-center">

            <div>
              <span class="text-3xl font-bold text-red-500">
                ₹<%= house.price %>
              </span>

              <span class="text-gray-500">
                / night
              </span>
            </div>

          </div>

          <!-- Buttons -->
          <div class="flex gap-3 mt-6">

            <a
              href="/host/edit-home/<%= house.id %>?editing=true"
              class="flex-1 bg-blue-600 hover:bg-blue-700 text-white text-center font-semibold py-3 rounded-lg transition duration-300">
              ✏️ Edit
            </a>

            <form
              action="/host/delete-home/<%= house.id %>"
              method="POST"
              class="flex-1">

              <button
                type="submit"
                class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-lg transition duration-300">
                🗑 Delete
              </button>

            </form>

          </div>

        </div>

      </div>

      <% }) %>

    </div>

  </div>

</body>

</html>
```
