<header class="bg-red-500 shadow-lg sticky top-0 z-50">
  <nav class="container mx-auto px-6 py-3.5 flex justify-between items-center">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
           class="w-7 h-7 text-white transition-transform duration-300 group-hover:scale-110">
        <path d="M12 2.2c-.6 0-1.1.3-1.5.8L4.6 11c-1 1.3-1.5 2.9-1.5 4.5C3.1 19.1 6 22 9.6 22c1.6 0 3-.6 4.1-1.6.4-.4 1-.4 1.4 0 1.1 1 2.5 1.6 4.1 1.6 3.6 0 6.5-2.9 6.5-6.5 0-1.6-.5-3.2-1.5-4.5l-5.9-8c-.4-.5-.9-.8-1.5-.8h-4.8z"/>
      </svg>
      <span class="text-white text-xl font-extrabold tracking-tight">airbnb</span>
    </a>

    <% if(isLoggedIn) { %>
    <!-- Desktop Navigation -->
    <ul class="hidden md:flex items-center gap-1 bg-red-600/30 rounded-full px-1.5 py-1.5">
      <li>
        <a href="/home"
          class="<%= pageTitle === 'Home' ? 'bg-white text-red-500 shadow-sm' : 'text-white/90 hover:text-white hover:bg-white/10' %> block px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200">
          Home
        </a>
      </li>
      <li>
        <a href="/bookings"
          class="<%= pageTitle === 'bookings' ? 'bg-white text-red-500 shadow-sm' : 'text-white/90 hover:text-white hover:bg-white/10' %> block px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200">
          Bookings
        </a>
      </li>
      <li>
        <a href="/favourite"
          class="<%= pageTitle === 'favourite' ? 'bg-white text-red-500 shadow-sm' : 'text-white/90 hover:text-white hover:bg-white/10' %> block px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200">
          Favourite
        </a>
      </li>
      <li class="w-px h-5 bg-white/25 mx-1"></li>
      <li>
        <a href="/host/add-home"
          class="<%= pageTitle === 'add-Home' ? 'bg-white text-red-500 shadow-sm' : 'text-white/90 hover:text-white hover:bg-white/10' %> block px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200">
          Add Home
        </a>
      </li>
      <li>
        <a href="/host/host-list"
          class="<%= pageTitle === 'host-list' ? 'bg-white text-red-500 shadow-sm' : 'text-white/90 hover:text-white hover:bg-white/10' %> block px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200">
          Host list
        </a>
      </li>
    </ul>
    <% } %>

    <!-- Right side -->
    <% if(!isLoggedIn){ %>
      <div class="hidden md:flex items-center gap-3">
        <a href="/signup"
          class="text-white/90 hover:text-white px-4 py-2 rounded-full text-sm font-semibold transition-colors duration-200">
          Signup
        </a>
        <a href="/login"
          class="bg-white text-red-500 px-5 py-2 rounded-full text-sm font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
          Login
        </a>
      </div>
    <% } else { %>
      <div class="hidden md:flex items-center gap-3">
        <span class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center text-white font-bold text-sm">
          <%= (typeof userInitial !== 'undefined') ? userInitial : 'U' %>
        </span>
        <form action="/logout" method="POST">
          <button type="submit"
            class="border border-white/40 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-white hover:text-red-500 transition-all duration-200">
            Logout
          </button>
        </form>
      </div>
    <% } %>

    <!-- Mobile menu toggle -->
    <button id="navToggle" class="md:hidden text-white p-2" aria-label="Toggle menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="navMenu" class="hidden md:hidden bg-red-600 px-6 pb-4 pt-2 space-y-1">
    <% if(isLoggedIn) { %>
      <a href="/home" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Home</a>
      <a href="/bookings" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Bookings</a>
      <a href="/favourite" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Favourite</a>
      <a href="/host/add-home" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Add Home</a>
      <a href="/host/host-list" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Host list</a>
      <form action="/logout" method="POST" class="pt-2">
        <button type="submit" class="w-full text-left px-3 py-2 rounded-lg text-white font-semibold border border-white/40">Logout</button>
      </form>
    <% } else { %>
      <a href="/signup" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Signup</a>
      <a href="/login" class="block px-3 py-2 rounded-lg text-white font-medium hover:bg-white/10">Login</a>
    <% } %>
  </div>
</header>

<script>
  document.getElementById('navToggle').addEventListener('click', function () {
    document.getElementById('navMenu').classList.toggle('hidden');
  });
</script>
