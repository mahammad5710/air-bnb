<%- include('../partials/head') %>

<body class="bg-gray-100">

  <%- include('../partials/nav') %>

  <!-- Heading -->
  <section class="text-center py-12">
    <h1 class="text-5xl font-bold text-gray-800">
      🏡 Favourites
    </h1>
  </section>

  <!-- Cards -->
  <div class="max-w-7xl mx-auto px-6 pb-10">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <% regHouses.forEach(house => { %>

      <div
        class="bg-white rounded-3xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">

        <!-- Image -->
        <img
          src="/images/house.jpg"
          alt="<%= house.home %>"
          class="w-full h-60 object-cover">

        <!-- Content -->
        <div class="p-5">

          <div class="flex justify-between items-start">

            <div>
              <h2 class="text-2xl font-bold text-gray-800">
                <%= house.home %>
              </h2>

              <p class="text-gray-500 mt-1">
                📍 <%= house.location %>
              </p>
            </div>

            <span
              class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full font-semibold">
              ⭐ <%= house.rating %>
            </span>

          </div>

          <p class="text-gray-600 mt-4 leading-relaxed">
            <%= house.description %>
          </p>

          <div class="border-t mt-5 pt-4 flex justify-between items-center">

            <div>
              <span class="text-3xl font-bold text-red-500">
                ₹<%= house.price %>
              </span>

              <span class="text-gray-500">
                / night
              </span>
            </div>

          </div>
          <button class="bg-green-300 p-3 m-0.5">Book</button>

        </div>

      </div>

      <% }) %>
    </div>

  </div>

</body>

</html>